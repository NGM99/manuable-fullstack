# Optional local configuration. Compose starts without an .env file.
# These are development credentials, never production secrets.
DB_USER=manuable
DB_PASSWORD=manuable_local_only
DB_NAME=manuable_development
BACKEND_PORT=3000
FRONTEND_PORT=5173
ADMIN_USER=comercial
ADMIN_PASSWORD=manuable_local_only

# Enable for Windows/Docker when filesystem events do not reach Vite.
# Leave false on Mac/Linux when normal file watching works.
WATCH_USE_POLLING=false
